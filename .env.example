# 复制为 .env.local 后填入实际值。只排盘、不看 AI 解读可以不填 Key。
# 改完 .env.local 需要重启 `npm run dev`。

# ─── AI 推理（OpenAI 兼容 /chat/completions，任选一家）───
# 默认 xAI Grok。也支持 deepseek，以及 mimo（任意兼容接口）。
AI_PROVIDER=grok

# xAI Grok。控制台申请 Key：https://console.x.ai
# XAI_MODEL 默认 grok-4.7（xAI Chat Completions 文档里的当前对话模型）。
# 若该型号不可用，改成控制台列出的对话模型即可。
XAI_API_KEY=your-xai-api-key
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_MODEL=grok-4.7

# ─── 或用 DeepSeek ───
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# ─── 或其他 OpenAI 兼容模型 ───
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
